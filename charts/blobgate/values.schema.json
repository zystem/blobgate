{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["rqliteUrl"],
  "properties": {
    "replicas": {"type": "integer", "minimum": 1},
    "rqliteUrl": {"type": "string", "pattern": "^https?://.+"},
    "existingSecret": {"type": "string"},
    "secrets": {
      "type": "object",
      "properties": {
        "tenants": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"}, "additionalProperties": {"type": "string", "minLength": 16}},
        "shards": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9_][a-z0-9_-]{0,63}$"}, "additionalProperties": {"type": "string", "minLength": 16}},
        "adminToken": {"type": "string"},
        "sealKey": {"type": "string"}
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "shimPort": {"type": "integer", "minimum": 0, "maximum": 65535},
        "metricsPort": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    }
  }
}
